# Optional override for the lead form destination.
N8N_LEAD_WEBHOOK=https://your-n8n-host.example/webhook/your-webhook-id

# Shared tools workflow. Route each request with $json.body.tool in n8n.
N8N_TOOLS_WEBHOOK=https://your-n8n-host.example/webhook/your-tools-webhook-id

# Optional bearer token when the shared tools webhook checks Authorization.
N8N_TOOLS_TOKEN=
